vault_aldera_db_password: "change-this-db-password"
vault_aldera_seed_admin_email: "admin@aldera.tech"
vault_aldera_seed_admin_password: "change-this-admin-password"
vault_aldera_smtp_host: ""
vault_aldera_smtp_port: "587"
vault_aldera_smtp_user: ""
