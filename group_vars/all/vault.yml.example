---
# ============================================================================
# Sensitive Variables Template (Copy to vault.yml and customize)
# ============================================================================
# This is an EXAMPLE file. DO NOT encrypt this file.
#
# To use:
#   1. Copy this file: cp vault.yml.example vault.yml
#   2. Edit vault.yml and replace all values
#   3. Encrypt: make vault-encrypt FILE=group_vars/all/vault.yml
#
# ============================================================================

# GitHub Container Registry Credentials
vault_github_token: "REPLACE_WITH_GITHUB_PAT"
vault_docker_password: "your-github-personal-access-token"

# User Management Secrets
vault_users:
  - username: "deploy"
    password: "$6$rounds=656000$... (use mkpasswd --method=sha-512)"
    ssh_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@host"

# Database Credentials - MySQL
vault_mysql_root_password: "change-this-strong-password-min-20-chars"
vault_mysql_databases:
  materi_ku:
    name: "materi_ku_production"
    user: "materi_ku_user"
    password: "change-this-db-password"

# Database Credentials - Redis
vault_redis_password: "change-this-redis-password"

# Application Secrets - Example
vault_materi_ku:
  app_name: "Materi Ku"
  app_key: "base64:generate-with-php-artisan-key:generate"
  app_url: "https://materi-ku.example.com"
  db_password: "change-this-db-password"
  redis_password: "change-this-redis-password"
  mail_password: "your-smtp-password"

# Location Based Presence Web
vault_location_based_presence_web_app_key: "base64:generate-with-php-artisan-key:generate"
vault_location_based_presence_web_app_url: "https://location-based-presence.solvo-tech.site"
vault_location_based_presence_web_db_host: "mysql-db"
vault_location_based_presence_web_db_port: "3306"
vault_location_based_presence_web_db_database: "location_based_presence"
vault_location_based_presence_web_db_username: "location_based_presence"
vault_location_based_presence_web_db_password: "change-this-db-password"

# Location Based Presence Mobile
vault_location_based_presence_mobile_api_base_url: "https://location-based-presence.solvo-tech.site/api/mobile"

# Lelang Fashion Web
vault_lelang_fashion_web_app_key: "base64:generate-with-php-artisan-key:generate"
vault_lelang_fashion_web_app_url: "https://lelang-fashion.solvo-tech.site"
vault_lelang_fashion_web_db_host: "mysql-db"
vault_lelang_fashion_web_db_port: "3306"
vault_lelang_fashion_web_db_database: "pelelangan_produk_fashion"
vault_lelang_fashion_web_db_username: "lelang_fashion"
vault_lelang_fashion_web_db_password: "change-this-db-password"
vault_lelang_fashion_web_fonnte_token: ""

# Lelang Fashion Mobile
vault_lelang_fashion_mobile_api_base_url: "https://lelang-fashion.solvo-tech.site/api"

# Demo SQL Injection
vault_demo_sql_injection_db_host: "mysql-db"
vault_demo_sql_injection_db_port: "3306"
vault_demo_sql_injection_db_database: "bank_lab"
vault_demo_sql_injection_db_username: "demo_sql_injection"
vault_demo_sql_injection_db_password: "change-this-db-password"

# Challenge SQL Injection
vault_challenge_sql_injection_db_host: "mysql-db"
vault_challenge_sql_injection_db_port: "3306"
vault_challenge_sql_injection_db_database: "academic_lab"
vault_challenge_sql_injection_db_username: "challenge_sql_injection"
vault_challenge_sql_injection_db_password: "change-this-db-password"

# Solvo Tech Next.js
vault_solvo_app_url: "https://solvo-tech.site"
vault_solvo_nextauth_url: "https://solvo-tech.site"
vault_solvo_auth_secret: "change-this-auth-secret"
vault_solvo_cron_secret: "change-this-cron-secret"
vault_solvo_db_host: "postgres-db"
vault_solvo_db_port: "5432"
vault_solvo_db_database: "solvo_tech"
vault_solvo_db_username: "solvo_tech"
vault_solvo_db_password: "change-this-db-password"
vault_solvo_seed_admin_email: "admin@solvo-tech.site"
vault_solvo_seed_admin_password: "change-this-admin-password"
vault_solvo_smtp_host: ""
vault_solvo_smtp_port: "587"
vault_solvo_smtp_user: ""
vault_solvo_smtp_password: ""
vault_solvo_smtp_from: "Solvo Tech <no-reply@solvo-tech.site>"
vault_solvo_whatsapp_api_url: ""
vault_solvo_whatsapp_api_key: ""

# Add more as needed...
