# Lelang Fashion Mobile
vault_lelang_fashion_mobile_api_base_url: "https://lelang-fashion.alfian-gading.my.id/api"

# Aldera Tech (formerly Solvo)
vault_aldera_app_url: "https://aldera.tech"
vault_aldera_nextauth_url: "https://aldera.tech"
vault_aldera_auth_secret: "change-this-auth-secret"
vault_aldera_cron_secret: "change-this-cron-secret"
