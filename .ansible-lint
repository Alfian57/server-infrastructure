# Ansible Lint Configuration
# See: https://ansible.readthedocs.io/projects/lint/configuring/

profile: production

# Exclude paths
exclude_paths:
  - .git/
  - .github/
  - Makefile.old
  - .ansible/
  - .codex/
  - venv/

# Enable specific rules
enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner

# Skip specific rules
skip_list:
  - yaml[line-length]  # Allow long lines in YAML
  - yaml[trailing-spaces]  # Legacy files will be cleaned incrementally
  - yaml[braces]       # Legacy Jinja formatting debt
  - name[casing]       # Allow flexible naming
  - name[template]     # Catalog loop tasks include app names dynamically
  - no-handler         # Existing roles intentionally run follow-up tasks inline
  - no-changed-when    # Existing operational commands need a broader idempotency pass
  - risky-shell-pipe   # Existing shell pipelines are tracked as legacy debt
  - ignore-errors      # Existing roles use best-effort hardening/cleanup tasks
  - command-instead-of-shell
  - command-instead-of-module
  - empty-string-compare

# Warn on specific rules (don't fail)
warn_list:
  - experimental
  - role-name
  - no-log-password

# Specific rule configurations
# var-naming pattern
var_naming_pattern: "^[a-z_][a-z0-9_]*$"

# Task naming
task_name_prefix: "{stem} | "

# Offline mode (don't download anything)
offline: true

# Use default rules
use_default_rules: true

# Show progress bar
quiet: false
