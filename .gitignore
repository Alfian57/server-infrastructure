# ═══════════════════════════════════════════════════════════
# Ansible Project .gitignore
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# SECURITY - NEVER COMMIT THESE!
# ─────────────────────────────────────────────────────────────
.vault_pass
vault_pass.txt
*.vault_pass
vault.yml.decrypted
*_unencrypted*
*password*.txt
.env
.env.*
!.env.example
!**/.env.example
!**/.env.j2

# Inventory with production hosts / credentials
inventory/hosts.ini
!inventory/hosts.ini.example

# Codex and Agent local state
.codex/
.agents/
app/

# SSH keys (in case accidentally placed here)
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx

# ─────────────────────────────────────────────────────────────
# Ansible temporary files
# ─────────────────────────────────────────────────────────────
*.retry
.ansible/
.ansible_facts_cache/
/tmp/ansible_facts_cache/

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ─────────────────────────────────────────────────────────────
# IDE/Editor
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.*.sw?

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# Temporary/Backup files
# ─────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
*.backup
*.log

# ─────────────────────────────────────────────────────────────
# Local testing
# ─────────────────────────────────────────────────────────────
test_*.yml
local_*.yml


# Vault files (only commit encrypted versions)
# DO NOT commit decrypted vault.yml
group_vars/all/vault.yml.decrypted
group_vars/**/vault_unencrypted.yml
*_vault_backup*.yml

# Backup directories
backup/
app-sesuaikan/

# Local testing
.vagrant/
*.box
