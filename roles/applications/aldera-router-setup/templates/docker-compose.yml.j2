# Aldera AI API Relay - Docker Compose
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  postgres:
    image: {{ aldera_router_postgres_image }}
    container_name: {{ aldera_router_postgres_container_name }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER:-${POSTGRES_USER:-aldera}}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-${POSTGRES_PASSWORD}}
      POSTGRES_DB: ${DB_NAME:-${POSTGRES_DB:-aldera_router}}
      PGDATA: ${PGDATA:-/var/lib/postgresql/data/pgdata}
    volumes:
      - {{ aldera_router_postgres_volume }}:/var/lib/postgresql/data
      - ./init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-${POSTGRES_USER:-aldera}} -d ${DB_NAME:-${POSTGRES_DB:-aldera_router}}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      aldera_router_internal:
        aliases:
          - postgres
          - {{ aldera_router_postgres_container_name }}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ aldera_router_postgres_memory_limit }}
        reservations:
          memory: {{ aldera_router_postgres_memory_reservation }}
    labels:
      - "autoheal=true"

  {{ aldera_router_9router_service_name }}:
    image: {{ aldera_router_9router_image }}
    container_name: {{ aldera_router_9router_container_name }}
    restart: unless-stopped
    environment:
      DATA_DIR: /app/data
      PORT: "{{ aldera_router_9router_port }}"
    volumes:
      - {{ aldera_router_9router_volume }}:/app/data
    networks:
      aldera_router_internal:
        aliases:
          - 9router
          - {{ aldera_router_9router_container_name }}
      {{ aldera_router_proxy_network }}:
        aliases:
{% if aldera_router_enable_generic_proxy_aliases | default(not (aldera_router_is_staging | default(false) | bool)) | bool %}
          - 9router
{% endif %}
          - {{ aldera_router_9router_container_name }}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ aldera_router_9router_memory_limit }}
        reservations:
          memory: {{ aldera_router_9router_memory_reservation }}
    labels:
      - "autoheal=true"

  {{ aldera_router_billing_proxy_service_name }}:
    image: {{ aldera_router_billing_proxy_image }}
{% if aldera_router_enable_local_build | default(false) %}
    build:
      context: ./src/billing-proxy
      dockerfile: Dockerfile
{% endif %}
    container_name: {{ aldera_router_billing_proxy_container_name }}
    restart: unless-stopped
    env_file:
      - .env
    depends_on:
      postgres:
        condition: service_healthy
      {{ aldera_router_9router_service_name }}:
        condition: service_started
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ aldera_router_billing_proxy_port }}/healthz"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      aldera_router_internal:
        aliases:
          - billing-proxy
          - {{ aldera_router_billing_proxy_container_name }}
      {{ aldera_router_proxy_network }}:
        aliases:
{% if aldera_router_enable_generic_proxy_aliases | default(not (aldera_router_is_staging | default(false) | bool)) | bool %}
          - billing-proxy
{% endif %}
          - {{ aldera_router_billing_proxy_container_name }}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ aldera_router_billing_proxy_memory_limit }}
        reservations:
          memory: {{ aldera_router_billing_proxy_memory_reservation }}
    labels:
      - "autoheal=true"

  telegram-bot:
    image: {{ aldera_router_bot_image }}
{% if aldera_router_enable_local_build | default(false) %}
    build:
      context: ./src/router-telegram-bot
      dockerfile: Dockerfile
{% endif %}
    container_name: {{ aldera_router_bot_container_name }}
    restart: unless-stopped
    env_file:
      - .env
    depends_on:
      postgres:
        condition: service_healthy
      {{ aldera_router_billing_proxy_service_name }}:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python3", "-c", "import bot.config; print('OK')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    networks:
      aldera_router_internal:
        aliases:
          - telegram-bot
          - router-telegram-bot
          - {{ aldera_router_bot_container_name }}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ aldera_router_bot_memory_limit }}
        reservations:
          memory: {{ aldera_router_bot_memory_reservation }}
    labels:
      - "autoheal=true"

networks:
  aldera_router_internal:
    name: {{ aldera_router_internal_network }}
    driver: bridge
  {{ aldera_router_proxy_network }}:
    name: {{ aldera_router_proxy_network }}
    external: true

volumes:
  {{ aldera_router_postgres_volume }}:
    name: {{ aldera_router_postgres_volume }}
  {{ aldera_router_9router_volume }}:
    name: {{ aldera_router_9router_volume }}
