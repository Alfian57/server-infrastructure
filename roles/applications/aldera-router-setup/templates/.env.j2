# =============================================================================
# Aldera AI API Relay - Environment Configuration
# Managed by Ansible (roles/applications/aldera-router-setup) - DO NOT EDIT MANUALLY
# =============================================================================

# Docker Compose Project Configuration
COMPOSE_PROJECT_NAME={{ aldera_router_project_name | default('aldera-router') }}

# Application & Environment Mode
APP_ENV={{ aldera_router_app_env | default('production') }}
LOG_LEVEL={{ aldera_router_log_level | default('info') }}

# -----------------------------------------------------------------------------
# Go Billing Proxy Gateway Settings
# -----------------------------------------------------------------------------
PORT={{ aldera_router_billing_proxy_port | default(8080) }}
SHUTDOWN_TIMEOUT={{ aldera_router_shutdown_timeout | default('15s') }}

# Upstream LLM Router (9router) Integration
UPSTREAM_URL={{ aldera_router_upstream_url | default('http://9router:20128') }}
UPSTREAM_TIMEOUT={{ aldera_router_upstream_timeout | default('120s') }}

# Financial & Security Policies
MIN_BALANCE_THRESHOLD={{ aldera_router_min_balance_threshold | default('500.0000') }}
AUTH_CACHE_TTL={{ aldera_router_auth_cache_ttl | default('60s') }}

# -----------------------------------------------------------------------------
# PostgreSQL Database Credentials & Pooling
# -----------------------------------------------------------------------------
POSTGRES_USER={{ aldera_router_db_user }}
POSTGRES_PASSWORD={{ aldera_router_db_password }}
POSTGRES_DB={{ aldera_router_db_name }}
PGDATA={{ aldera_router_pgdata | default('/var/lib/postgresql/data/pgdata') }}

# Internal DB Connection Parameters
DB_HOST={{ aldera_router_db_host | default('postgres') }}
DB_PORT={{ aldera_router_db_port | default(5432) }}
DB_USER={{ aldera_router_db_user }}
DB_PASSWORD={{ aldera_router_db_password }}
DB_NAME={{ aldera_router_db_name }}
DB_SSLMODE={{ aldera_router_db_sslmode | default('disable') }}

# Pool Constraints
DB_MAX_CONNS={{ aldera_router_db_max_conns | default(25) }}
DB_MIN_CONNS={{ aldera_router_db_min_conns | default(5) }}
DB_MAX_IDLE_TIME={{ aldera_router_db_max_idle_time | default('5m') }}

# Unified Database URL (escaped credentials for connection safety)
DATABASE_URL=postgresql://{{ aldera_router_db_user | urlencode }}:{{ aldera_router_db_password | urlencode }}@{{ aldera_router_db_host | default('postgres') }}:{{ aldera_router_db_port | default(5432) }}/{{ aldera_router_db_name }}?sslmode={{ aldera_router_db_sslmode | default('disable') }}

# -----------------------------------------------------------------------------
# Python Telegram Management Bot Settings (aiogram v3)
# -----------------------------------------------------------------------------
BOT_TOKEN={{ aldera_router_bot_token }}
ADMIN_TELEGRAM_IDS={{ (aldera_router_admin_telegram_ids | join(',')) if (aldera_router_admin_telegram_ids is iterable and aldera_router_admin_telegram_ids is not string) else (aldera_router_admin_telegram_ids if (aldera_router_admin_telegram_ids | default('') | length > 0) else '[]') }}

# Public API URL (shown in bot guide /cara_pakai and /apikey)
PUBLIC_API_URL={{ aldera_router_public_api_url | default('https://' + (aldera_router_api_domain | default('api.aldera.tech'))) }}

# Top-up Payment & Transfer Instructions
BANK_NAME={{ aldera_router_bank_name | default('BCA / Mandiri / QRIS') }}
BANK_ACCOUNT_NUMBER={{ aldera_router_bank_account_number | default('1234567890') }}
BANK_ACCOUNT_NAME={{ aldera_router_bank_account_name | default('PT Aldera Solusi Teknologi') }}
QRIS_IMAGE_URL={{ aldera_router_qris_image_url | default('') }}
