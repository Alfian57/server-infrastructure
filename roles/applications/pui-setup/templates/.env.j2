COMPOSE_PROJECT_NAME=pui
WEB_PORT=80
API_PORT=8080
VITE_API_BASE_URL=https://{{ pui_api_domain }}
VITE_ENVIRONMENT_NAME=production

POSTGRES_DB={{ pui_db_name }}
POSTGRES_USER={{ pui_db_username }}
POSTGRES_PASSWORD={{ pui_db_password }}

API_HTTP_ADDR=:8080
API_ALLOWED_ORIGIN=https://{{ pui_web_domain }}
API_DATABASE_URL=postgres://{{ pui_db_username }}:{{ pui_db_password }}@postgres-db:5432/{{ pui_db_name }}?sslmode=disable
API_MIGRATIONS_PATH=/app/db/migrations

APP_ENV=environment-a
HTTP_ADDR=:8080
ALLOWED_ORIGIN=https://{{ pui_web_domain }}
DATABASE_URL=postgres://{{ pui_db_username }}:{{ pui_db_password }}@postgres-db:5432/{{ pui_db_name }}?sslmode=disable
VAULT_UDS_PATH=/var/run/pui/uds/vault-core.sock
MIGRATIONS_PATH=/app/db/migrations
MAX_UPLOAD_SIZE_BYTES=536870912
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_MINUTES=1440

UDS_PATH=/var/run/pui/uds/vault-core.sock
BADGER_PATH=/var/lib/pui/badger
CHUNK_ROOT=/var/lib/pui/chunks
FASTCDC_MIN_CHUNK_SIZE=65536
FASTCDC_AVG_CHUNK_SIZE=262144
FASTCDC_MAX_CHUNK_SIZE=1048576
UDS_OWNER_UID=10002
UDS_OWNER_GID=20000
UDS_ALLOWED_UIDS=10001
