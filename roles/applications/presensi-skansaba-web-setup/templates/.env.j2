APP_NAME="{{ vault_presensi_skansaba_web_app_name }}"
APP_ENV=production
APP_KEY={{ vault_presensi_skansaba_web_app_key }}
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL={{ vault_presensi_skansaba_web_app_url }}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST={{ vault_presensi_skansaba_web_db_host }}
DB_PORT={{ vault_presensi_skansaba_web_db_port }}
DB_DATABASE={{ vault_presensi_skansaba_web_db_database }}
DB_USERNAME={{ vault_presensi_skansaba_web_db_username }}
DB_PASSWORD={{ vault_presensi_skansaba_web_db_password }}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_DRIVER=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis-server
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_APP_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS={{ vault_presensi_skansaba_web_sanctum_domains | default('localhost,127.0.0.1') }}
SANCTUM_GUARD=web

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

ATTENDANCE_CHECK_IN_START=06:00
ATTENDANCE_CHECK_IN_END=08:00
ATTENDANCE_CHECK_IN_LATE=07:00
ATTENDANCE_CHECK_OUT_START=15:00
ATTENDANCE_CHECK_OUT_END=17:00
ATTENDANCE_QR_EXPIRY_MINUTES=5
ATTENDANCE_QR_SIZE=300
ATTENDANCE_LOCATION_ENABLED=false
ATTENDANCE_LOCATION_REQUIRED=false
ATTENDANCE_SCHOOL_LATITUDE=
ATTENDANCE_SCHOOL_LONGITUDE=
ATTENDANCE_RADIUS_METERS=100
ATTENDANCE_PHOTO_ENABLED=false
ATTENDANCE_PHOTO_REQUIRED=false
ATTENDANCE_PHOTO_MAX_SIZE_KB=2048
ACADEMIC_YEAR=
ACADEMIC_SEMESTER=ganjil
MEDIA_DISK=public
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST={{ vault_presensi_skansaba_web_app_url }}
