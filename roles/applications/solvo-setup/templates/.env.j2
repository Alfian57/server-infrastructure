NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

DATABASE_URL=postgresql://{{ vault_solvo_db_username | urlencode }}:{{ vault_solvo_db_password | urlencode }}@{{ vault_solvo_db_host | default('postgres-db') }}:{{ vault_solvo_db_port | default('5432') }}/{{ vault_solvo_db_database }}?schema=public

AUTH_SECRET={{ vault_solvo_auth_secret }}
NEXTAUTH_URL={{ vault_solvo_nextauth_url | default('https://solvo-tech.site') }}
NEXT_PUBLIC_APP_URL={{ vault_solvo_app_url | default('https://solvo-tech.site') }}
AUTH_TRUST_HOST=true

SMTP_HOST={{ vault_solvo_smtp_host | default('') }}
SMTP_PORT={{ vault_solvo_smtp_port | default('587') }}
SMTP_USER={{ vault_solvo_smtp_user | default('') }}
SMTP_PASSWORD={{ vault_solvo_smtp_password | default('') }}
SMTP_FROM={{ vault_solvo_smtp_from | default('Solvo Tech <no-reply@solvo-tech.site>') }}

CRON_SECRET={{ vault_solvo_cron_secret }}

SEED_ADMIN_EMAIL={{ vault_solvo_seed_admin_email | default('admin@solvo-tech.site') }}
SEED_ADMIN_PASSWORD={{ vault_solvo_seed_admin_password }}

WHATSAPP_API_URL={{ vault_solvo_whatsapp_api_url | default('') }}
WHATSAPP_API_KEY={{ vault_solvo_whatsapp_api_key | default('') }}
