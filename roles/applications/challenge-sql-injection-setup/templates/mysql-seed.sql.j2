DROP DATABASE IF EXISTS `{{ vault_challenge_sql_injection_db_database }}`;
CREATE DATABASE `{{ vault_challenge_sql_injection_db_database }}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE `{{ vault_challenge_sql_injection_db_database }}`;

CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100) NOT NULL,
    password VARCHAR(100) NOT NULL,
    full_name VARCHAR(150) NOT NULL,
    role VARCHAR(50) NOT NULL
) ENGINE=InnoDB;

CREATE TABLE students (
    id INT AUTO_INCREMENT PRIMARY KEY,
    student_number VARCHAR(50) NOT NULL,
    full_name VARCHAR(150) NOT NULL,
    email VARCHAR(150) NOT NULL,
    phone VARCHAR(50) NOT NULL,
    gpa DECIMAL(3,2) NOT NULL,
    faculty VARCHAR(120) NOT NULL,
    status VARCHAR(50) NOT NULL
) ENGINE=InnoDB;

CREATE TABLE secret_flags (
    id INT AUTO_INCREMENT PRIMARY KEY,
    flag_key VARCHAR(100) NOT NULL,
    flag_value VARCHAR(255) NOT NULL,
    note TEXT NOT NULL
) ENGINE=InnoDB;

