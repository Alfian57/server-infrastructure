NODE_ENV=production
PORT=8080

DATABASE_URL={{ vault_file_pod_api_database_url }}

JWT_SECRET={{ vault_file_pod_api_jwt_secret }}
JWT_EXPIRES_IN=7d

MINIO_ENDPOINT={{ vault_file_pod_api_minio_endpoint }}
MINIO_PORT={{ vault_file_pod_api_minio_port }}
MINIO_ACCESS_KEY={{ vault_file_pod_api_minio_access_key }}
MINIO_SECRET_KEY={{ vault_file_pod_api_minio_secret_key }}
MINIO_BUCKET={{ vault_file_pod_api_minio_bucket }}
MINIO_USE_SSL=false
