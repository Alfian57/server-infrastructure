NODE_ENV=production
PORT=8080

# App Configuration
APP_URL={{ vault_file_pod_api_app_url }}
HOST=0.0.0.0

# CORS Settings
CORS_ORIGIN={{ vault_file_pod_api_cors_origin }}

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS=1000
COMMON_RATE_LIMIT_MAX_REQUESTS=20

# Database Configuration
DATABASE_URL={{ vault_file_pod_api_database_url }}

# JWT Configuration
JWT_SECRET={{ vault_file_pod_api_jwt_secret }}
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# MinIO Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY={{ vault_minio_root_user }}
MINIO_SECRET_KEY={{ vault_minio_root_password }}
MINIO_BUCKET_NAME=file-pod
