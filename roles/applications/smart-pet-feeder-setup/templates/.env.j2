APP_PORT=8080
GIN_MODE=release
CORS_ALLOW_ORIGIN={{ vault_smart_pet_feeder_cors_allow_origin | default('*') }}

DATABASE_URL=postgres://{{ vault_smart_pet_feeder_db_username }}:{{ vault_smart_pet_feeder_db_password }}@postgres-db:5432/smart_pet_feeder?sslmode=disable

JWT_SECRET={{ vault_smart_pet_feeder_jwt_secret }}
JWT_EXPIRES_IN_HOURS=24

DEVICE_API_KEY={{ vault_smart_pet_feeder_device_api_key }}

SEED_DEMO_OWNER=true
DEMO_OWNER_NAME={{ vault_smart_pet_feeder_demo_owner_name }}
DEMO_OWNER_EMAIL={{ vault_smart_pet_feeder_demo_owner_email }}
DEMO_OWNER_PASSWORD={{ vault_smart_pet_feeder_demo_owner_password }}

HISTORY_DEFAULT_LIMIT=50
HISTORY_MAX_LIMIT=200
