APP_NAME="{{ vault_ruang_istirahat_app_name }}"
APP_ENV=production
APP_KEY={{ vault_ruang_istirahat_app_key }}
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL={{ vault_ruang_istirahat_app_url }}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION={{ 'mariadb' if 'mariadb' in (mysql_effective_image | default(mysql_auto_image | default('mariadb:10.11'))) | lower else 'mysql' }}
DB_HOST={{ vault_ruang_istirahat_db_host }}
DB_PORT={{ vault_ruang_istirahat_db_port }}
DB_DATABASE={{ vault_ruang_istirahat_db_database }}
DB_USERNAME={{ vault_ruang_istirahat_db_username }}
DB_PASSWORD={{ vault_ruang_istirahat_db_password }}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_ID={{ vault_ruang_istirahat_midtrans_id | default('') }}
MIDTRANS_SERVER_KEY={{ vault_ruang_istirahat_midtrans_server_key }}
MIDTRANS_CLIENT_KEY={{ vault_ruang_istirahat_midtrans_client_key }}
MIDTRANS_IS_3DS={{ vault_ruang_istirahat_midtrans_is_3ds | lower }}
MIDTRANS_IS_SANITIZED={{ vault_ruang_istirahat_midtrans_is_sanitized | lower }}
MIDTRANS_IS_PRODUCTION={{ vault_ruang_istirahat_midtrans_is_production | lower }}
