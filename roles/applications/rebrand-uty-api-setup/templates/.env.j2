# Server
PORT={{ vault_rebrand_uty_api_port | default('8080') }}
GIN_MODE=release

# Database
DB_HOST={{ vault_rebrand_uty_api_db_host | default('postgres-db') }}
DB_PORT={{ vault_rebrand_uty_api_db_port | default('5432') }}
DB_USER={{ vault_rebrand_uty_api_db_username }}
DB_PASSWORD={{ vault_rebrand_uty_api_db_password }}
DB_NAME={{ vault_rebrand_uty_api_db_database }}

# JWT
JWT_SECRET={{ vault_rebrand_uty_api_jwt_secret }}
JWT_EXPIRY={{ vault_rebrand_uty_api_jwt_expiry | default('24h') }}
JWT_REFRESH_EXPIRY={{ vault_rebrand_uty_api_jwt_refresh_expiry | default('168h') }}

# Encryption
ENCRYPTION_KEY={{ vault_rebrand_uty_api_encryption_key }}

# File Upload
UPLOAD_DIR={{ vault_rebrand_uty_api_upload_dir | default('./uploads') }}
MAX_FILE_SIZE={{ vault_rebrand_uty_api_max_file_size | default('26214400') }}

# CORS
ALLOWED_ORIGINS={{ vault_rebrand_uty_api_allowed_origins | default('https://sistertika.alfian-gading.my.id,https://sistertika-api.alfian-gading.my.id') }}

# Timezone
TZ={{ vault_rebrand_uty_api_tz | default('Asia/Jakarta') }}
