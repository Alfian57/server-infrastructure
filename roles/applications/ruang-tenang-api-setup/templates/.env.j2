APP_ENV=production
APP_PORT=8080
PORT={{ portfolio_app.app_port | default(8080) }}
APP_TIMEZONE=Asia/Jakarta
API_PUBLIC_URL=https://{{ portfolio_app.proxy.domain }}

DB_HOST={{ vault_ruang_tenang_api_db_host | default('postgres-db') }}
DB_PORT={{ vault_ruang_tenang_api_db_port | default('5432') }}
DB_NAME={{ vault_ruang_tenang_api_db_name }}
DB_USER={{ vault_ruang_tenang_api_db_user }}
DB_PASSWORD={{ vault_ruang_tenang_api_db_password }}
DATABASE_URL=postgres://{{ vault_ruang_tenang_api_db_user | urlencode }}:{{ vault_ruang_tenang_api_db_password | urlencode }}@{{ vault_ruang_tenang_api_db_host | default('postgres-db') }}:{{ vault_ruang_tenang_api_db_port | default('5432') }}/{{ vault_ruang_tenang_api_db_name }}?sslmode=disable
MIGRATIONS_PATH=./migrations
RUN_MIGRATE={{ app_run_migrate | default(true) | string | lower }}
RUN_MIGRATE_FRESH={{ app_run_fresh_migrate | default(false) | string | lower }}
RUN_SEEDER={{ app_run_seeder | default(false) | string | lower }}
SEED_ADMIN_PASSWORD={{ vault_ruang_tenang_api_seed_admin_password | default('') }}

JWT_SECRET={{ vault_ruang_tenang_api_jwt_secret }}
JWT_EXPIRY_HOURS=24

CORS_ALLOWED_ORIGINS={{ vault_ruang_tenang_api_cors_origins | default('https://ruang-tenang.my.id') }}
FRONTEND_URL={{ vault_ruang_tenang_api_frontend_url | default('https://ruang-tenang.my.id') }}

# AI model defaults from the repository's .env.example
AI_CHAT_MODEL=deepseek-flash
AI_JOURNAL_MODEL=deepseek-flash
AI_MODERATION_MODEL=deepseek-flash
AI_WELLNESS_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY={{ vault_ruang_tenang_api_deepseek_api_key }}
FONNTE_TOKEN={{ vault_ruang_tenang_api_fonnte_token }}
# AI Chat (Gemini API)
GEMINI_API_KEY={{ vault_ruang_tenang_api_gemini_api_key | default('') }}
CHAT_DAILY_MESSAGE_LIMIT=20
CHAT_QUOTA_RESET_INTERVAL=24h

DUITKU_SANDBOX=true
DUITKU_API_KEY={{ vault_ruang_tenang_api_duitku_api_key }}
DUITKU_MERCHANT_CODE={{ vault_ruang_tenang_api_duitku_merchant_code }}

MIDTRANS_BASE_URL={{ vault_ruang_tenang_api_midtrans_base_url | default('https://api.midtrans.com') }}
MIDTRANS_SERVER_KEY={{ vault_ruang_tenang_api_midtrans_server_key | default('') }}

CACHE_TTL_MINUTES=60
CACHE_LEVEL_CONFIG_TTL_MINUTES=60
CACHE_CONTENT_SYNC_INTERVAL_SECONDS=300

VAPID_PUBLIC_KEY={{ vault_ruang_tenang_api_vapid_public_key | default('') }}
VAPID_PRIVATE_KEY={{ vault_ruang_tenang_api_vapid_private_key | default('') }}
VAPID_CONTACT={{ vault_ruang_tenang_api_vapid_contact | default('') }}
