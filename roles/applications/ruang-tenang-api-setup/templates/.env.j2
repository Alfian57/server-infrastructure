APP_ENV=production
APP_PORT=8080

DB_HOST={{ vault_ruang_tenang_api_db_host }}
DB_PORT={{ vault_ruang_tenang_api_db_port }}
DB_NAME={{ vault_ruang_tenang_api_db_name }}
DB_USER={{ vault_ruang_tenang_api_db_user }}
DB_PASSWORD={{ vault_ruang_tenang_api_db_password }}
DB_SSL_MODE=disable

JWT_SECRET={{ vault_ruang_tenang_api_jwt_secret }}
JWT_EXPIRY_HOURS=24

REDIS_HOST=redis-db
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_DB=0

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
