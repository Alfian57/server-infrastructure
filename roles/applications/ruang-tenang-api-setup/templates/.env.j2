APP_ENV=production
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

DB_HOST={{ vault_ruang_tenang_api_db_host | default('postgres-db') }}
DB_PORT={{ vault_ruang_tenang_api_db_port | default('5432') }}
DB_NAME={{ vault_ruang_tenang_api_db_name }}
DB_USER={{ vault_ruang_tenang_api_db_user }}
DB_PASSWORD={{ vault_ruang_tenang_api_db_password }}
DB_SSL_MODE=disable

JWT_SECRET={{ vault_ruang_tenang_api_jwt_secret }}
JWT_EXPIRY_HOURS=24

CORS_ALLOWED_ORIGINS={{ vault_ruang_tenang_api_cors_origins | default('https://ruang-tenang.site') }}
FRONTEND_URL={{ vault_ruang_tenang_api_frontend_url | default('https://ruang-tenang.site') }}

# AI Chat (Gemini API)
GEMINI_API_KEY={{ vault_ruang_tenang_api_gemini_api_key | default('') }}
CHAT_DAILY_MESSAGE_LIMIT=20
CHAT_QUOTA_RESET_INTERVAL=24h

MIDTRANS_BASE_URL={{ vault_ruang_tenang_api_midtrans_base_url | default('https://api.midtrans.com') }}
MIDTRANS_SERVER_KEY={{ vault_ruang_tenang_api_midtrans_server_key | default('') }}

CACHE_TTL_MINUTES=60
CACHE_LEVEL_CONFIG_TTL_MINUTES=60
CACHE_CONTENT_SYNC_INTERVAL_SECONDS=300

VAPID_PUBLIC_KEY={{ vault_ruang_tenang_api_vapid_public_key | default('') }}
VAPID_PRIVATE_KEY={{ vault_ruang_tenang_api_vapid_private_key | default('') }}
VAPID_CONTACT={{ vault_ruang_tenang_api_vapid_contact | default('') }}

REDIS_HOST=redis-server
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_DB=0

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
