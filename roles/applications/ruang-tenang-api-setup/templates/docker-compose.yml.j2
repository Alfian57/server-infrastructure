services:
  ruang-tenang-api:
    image: ghcr.io/alfian57/ruang-tenang-api:latest
    container_name: ruang-tenang-api
    env_file:
      - .env
    environment:
      - RUN_MIGRATE={{ run_migrate | default(false) | string | lower }}
      - RUN_MIGRATE_FRESH={{ run_fresh_migrate | default(false) | string | lower }}
      - RUN_SEEDER={{ run_seeder | default(false) | string | lower }}
      # Proxy configuration for Gemini API (bypass region block via Cloudflare WARP)
      - HTTP_PROXY=http://{{ warp_forward_bind_address }}:{{ warp_forward_port }}
      - HTTPS_PROXY=http://{{ warp_forward_bind_address }}:{{ warp_forward_port }}
      - http_proxy=http://{{ warp_forward_bind_address }}:{{ warp_forward_port }}
      - https_proxy=http://{{ warp_forward_bind_address }}:{{ warp_forward_port }}
      - NO_PROXY={{ warp_no_proxy }}
      - no_proxy={{ warp_no_proxy }}
    restart: unless-stopped
    volumes:
      - ruang_tenang_api_uploads:/app/uploads
    networks:
      - nginx_proxy_manager_network
      - postgres_network
      - redis_network
    healthcheck:
      test: ["CMD", "wget", "-Y", "off", "--spider", "-q", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  nginx_proxy_manager_network:
    external: true
  postgres_network:
    external: true
  redis_network:
    external: true

volumes:
  ruang_tenang_api_uploads:
