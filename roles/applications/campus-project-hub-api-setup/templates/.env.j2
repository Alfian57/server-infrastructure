APP_ENV=production
APP_PORT=8080
APP_NAME=campus-project-hub-api

DB_HOST={{ vault_campus_project_hub_api_db_host }}
DB_PORT={{ vault_campus_project_hub_api_db_port }}
DB_NAME={{ vault_campus_project_hub_api_db_name }}
DB_USER={{ vault_campus_project_hub_api_db_user }}
DB_PASSWORD={{ vault_campus_project_hub_api_db_password }}

JWT_SECRET={{ vault_campus_project_hub_api_jwt_secret }}
JWT_EXPIRATION=24h

CORS_ALLOWED_ORIGINS={{ vault_campus_project_hub_api_cors_origins | default('*') }}

GOOGLE_CLIENT_ID={{ vault_campus_project_hub_api_google_client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ vault_campus_project_hub_api_google_client_secret | default('') }}
