APP_ENV=production
APP_PORT=8080
APP_NAME={{ app_name }}
APP_DEBUG=false
APP_BASE_URL=https://{{ app_name }}.alfian-gading.site

DB_HOST={{ vault_campus_project_hub_api_db_host | default('postgres-db') }}
DB_PORT={{ vault_campus_project_hub_api_db_port | default('5432') }}
DB_NAME={{ vault_campus_project_hub_api_db_name }}
DB_USER={{ vault_campus_project_hub_api_db_user }}
DB_PASSWORD={{ vault_campus_project_hub_api_db_password }}
DB_SSLMODE=disable

JWT_SECRET={{ vault_campus_project_hub_api_jwt_secret }}
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

CORS_ALLOWED_ORIGINS={{ vault_campus_project_hub_api_cors_origins | default('*') }}

# OAuth - Google
GOOGLE_CLIENT_ID={{ vault_campus_project_hub_api_google_client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ vault_campus_project_hub_api_google_client_secret | default('') }}
GOOGLE_REDIRECT_URL=https://{{ app_name }}.alfian-gading.site/api/v1/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID={{ vault_campus_project_hub_api_github_client_id | default('') }}
GITHUB_CLIENT_SECRET={{ vault_campus_project_hub_api_github_client_secret | default('') }}
GITHUB_REDIRECT_URL=https://{{ app_name }}.alfian-gading.site/api/v1/auth/github/callback

# Midtrans
MIDTRANS_SERVER_KEY={{ vault_campus_project_hub_api_midtrans_server_key | default('') }}
MIDTRANS_CLIENT_KEY={{ vault_campus_project_hub_api_midtrans_client_key | default('') }}
MIDTRANS_IS_PRODUCTION={{ vault_campus_project_hub_api_midtrans_is_production | default(false) | lower }}

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# Frontend URL (for CORS)
FRONTEND_URL=https://campus-project-hub-web.alfian-gading.site
