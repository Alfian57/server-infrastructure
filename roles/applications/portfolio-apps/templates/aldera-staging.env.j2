NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

AUTO_MIGRATE=true

DATABASE_URL=postgresql://{{ (vault_aldera_staging_db_username | default('aldera_tech_staging')) | urlencode }}:{{ (vault_aldera_staging_db_password | default(vault_aldera_db_password)) | urlencode }}@{{ vault_aldera_staging_db_host | default(vault_aldera_db_host | default('postgres-db')) }}:{{ vault_aldera_staging_db_port | default(vault_aldera_db_port | default('5432')) }}/{{ vault_aldera_staging_db_database | default('aldera_tech_staging') }}?schema=public

# Secondary pool for Aldera AI Relay (connected to staging router database)
ROUTER_DATABASE_URL=postgresql://{{ (vault_aldera_router_staging_db_user | default('aldera')) | urlencode }}:{{ (vault_aldera_router_staging_db_password | default(vault_aldera_router_db_password)) | urlencode }}@aldera-router-staging-postgres:5432/{{ vault_aldera_router_staging_db_name | default('aldera_router_staging') }}?sslmode=disable

# 9router Upstream LLM Gateway
NINE_ROUTER_BASE_URL=http://aldera-router-staging-9router:20128
NINE_ROUTER_API_KEY={{ vault_aldera_router_staging_9router_password | default(vault_aldera_router_9router_initial_password) | default('') }}

AUTH_SECRET={{ vault_aldera_staging_auth_secret | default(vault_aldera_auth_secret) }}
NEXTAUTH_URL={{ vault_aldera_staging_nextauth_url | default('https://staging.aldera.tech') }}
NEXT_PUBLIC_APP_URL={{ vault_aldera_staging_app_url | default('https://staging.aldera.tech') }}
AUTH_TRUST_HOST=true

CRON_SECRET={{ vault_aldera_staging_cron_secret | default(vault_aldera_cron_secret) }}

SEED_ADMIN_EMAIL={{ vault_aldera_seed_admin_email | default('admin@aldera.tech') }}
SEED_ADMIN_PASSWORD={{ vault_aldera_seed_admin_password }}

WHATSAPP_API_URL={{ vault_aldera_staging_whatsapp_api_url | default(vault_aldera_whatsapp_api_url | default('https://api.fonnte.com/send')) }}
WHATSAPP_API_KEY={{ vault_aldera_staging_whatsapp_api_key | default(vault_aldera_whatsapp_api_key) }}

# Sharp / Image Processing
SHARP_IGNORE_GLOBAL_LIBVIPS=1

# Payment Gateway (Midtrans - Sandbox in Staging)
MIDTRANS_SERVER_KEY={{ vault_aldera_staging_midtrans_server_key | default('') }}
MIDTRANS_CLIENT_KEY={{ vault_aldera_staging_midtrans_client_key | default('') }}
MIDTRANS_IS_PRODUCTION={{ vault_aldera_staging_midtrans_is_production | default('false') }}

# Cloudflare Turnstile (Empty activates client-side test bypass mock)
NEXT_PUBLIC_TURNSTILE_SITE_KEY={{ vault_aldera_staging_turnstile_site_key | default('') }}
TURNSTILE_SECRET_KEY={{ vault_aldera_staging_turnstile_secret_key | default('') }}
