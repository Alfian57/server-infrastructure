# Gamblock-AI Backend — Runtime Environment Configuration
APP_ENV={{ vault_gamblock_backend_app_env | default('production') }}
HTTP_ADDR=:8080
PUBLIC_WEB_BASE_URL={{ vault_gamblock_backend_public_web_base_url | default('https://gamblock-ai.com') }}
NOTIFICATION_MODE={{ vault_gamblock_backend_notification_mode | default('production') }}
ENABLE_DEV_LOGIN={{ vault_gamblock_backend_enable_dev_login | default(false) | bool | lower }}
ENABLE_DEMO_DATA={{ vault_gamblock_backend_enable_demo_data | default(false) | bool | lower }}

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://{{ vault_gamblock_backend_db_username | default('gamblock') }}:{{ vault_gamblock_backend_db_password | default(vault_postgres_password | default('change-this-db-password')) }}@postgres-db:5432/gamblock?sslmode=disable

# Authentication (JWT)
JWT_ACCESS_SECRET={{ vault_gamblock_backend_jwt_access_secret | default((vault_gamblock_backend.jwt_access_secret if vault_gamblock_backend is defined else '') | default('')) }}
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

# Device-Bound Protection Grants (ES256 ECDSA P-256)
PROTECTION_GRANT_SIGNING_PRIVATE_KEY={{ vault_gamblock_backend_protection_grant_signing_private_key | default((vault_gamblock_backend.protection_grant_signing_private_key if vault_gamblock_backend is defined else '') | default('')) }}
PROTECTION_GRANT_SIGNING_KEY_ID={{ vault_gamblock_backend_protection_grant_signing_key_id | default(protection_grant_signing_key_id | default('grant-2026-01')) }}

# CORS Configuration
CORS_ALLOWED_ORIGINS={{ vault_gamblock_backend_cors_origins | default('https://gamblock-ai.com,https://www.gamblock-ai.com') }}

# Storage Directories (Mapped to Named Volumes)
ARTIFACT_STORAGE_PATH=/app/var/artifacts
EXPORT_STORAGE_PATH=/app/var/exports
MEDIA_STORAGE_PATH=/app/var/media/education
AVATAR_STORAGE_PATH=/app/var/media/avatars
MEDIA_EMBED_ALLOWED_HOSTS={{ vault_gamblock_backend_media_embed_allowed_hosts | default('www.youtube-nocookie.com,player.vimeo.com,who.int,www.who.int,ppatk.go.id,www.ppatk.go.id,ojk.go.id,www.ojk.go.id,komdigi.go.id,www.komdigi.go.id,kemkes.go.id,www.kemkes.go.id') }}

# AES-256 Journal Encryption Key
JOURNAL_ENCRYPTION_KEY={{ vault_gamblock_backend_journal_encryption_key | default((vault_gamblock_backend.journal_encryption_key if vault_gamblock_backend is defined else '') | default('')) }}

# Fonnte WhatsApp Gateway
FONNTE_TOKEN={{ vault_gamblock_backend_fonnte_token | default((vault_gamblock_backend.fonnte_token if vault_gamblock_backend is defined else '') | default('')) }}
FONNTE_BASE_URL={{ vault_gamblock_backend_fonnte_base_url | default((vault_gamblock_backend.fonnte_base_url if vault_gamblock_backend is defined and vault_gamblock_backend.fonnte_base_url else 'https://api.fonnte.com')) | default('https://api.fonnte.com') }}
FONNTE_COUNTRY_CODE={{ vault_gamblock_backend_fonnte_country_code | default((vault_gamblock_backend.fonnte_country_code if vault_gamblock_backend is defined and vault_gamblock_backend.fonnte_country_code else '62')) | default('62') }}

# DeepSeek AI Gateway
DEEPSEEK_API_KEY={{ vault_gamblock_backend_deepseek_api_key | default((vault_gamblock_backend.deepseek_api_key if vault_gamblock_backend is defined else '') | default('')) }}
DEEPSEEK_BASE_URL={{ vault_gamblock_backend_deepseek_base_url | default(deepseek_base_url | default('https://api.deepseek.com')) }}
DEEPSEEK_MODEL={{ vault_gamblock_backend_deepseek_model | default(deepseek_model | default('deepseek-flash')) }}
SPK_LLM_ENRICHMENT={{ vault_gamblock_backend_spk_llm_enrichment | default(spk_llm_enrichment | default(true)) | bool | lower }}

# Web Push (VAPID Keys)
VAPID_PUBLIC_KEY={{ vault_gamblock_backend_vapid_public_key | default(vapid_public_key | default('BJa71prmSZVxNWcWczYLgXi2PWnniFjc_Fv83CvLD3vnRT0f0fU_VgdBwJW7NFaXtXnorE_6KY0F28XWVYkMXyc')) }}
VAPID_PRIVATE_KEY={{ vault_gamblock_backend_vapid_private_key | default((vault_gamblock_backend.vapid_private_key if vault_gamblock_backend is defined else (vault_vapid_private_key | default(''))) | default('')) }}
VAPID_SUBJECT={{ vault_gamblock_backend_vapid_subject | default(vapid_subject | default('mailto:support@gamblock-ai.com')) }}

# One-Shot Tool Guard Constants
CONFIRM_DEMO_SEED=
CONFIRM_SEED_ACCOUNTS=
CONFIRM_MIGRATE_DOWN=
CONFIRM_RESET_STORAGE=
