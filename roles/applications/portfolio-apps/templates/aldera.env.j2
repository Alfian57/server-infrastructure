NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

DATABASE_URL=postgresql://{{ vault_aldera_db_username | default(vault_solvo_db_username) | urlencode }}:{{ vault_aldera_db_password | default(vault_solvo_db_password) | urlencode }}@{{ vault_aldera_db_host | default(vault_solvo_db_host | default('postgres-db')) }}:{{ vault_aldera_db_port | default(vault_solvo_db_port | default('5432')) }}/{{ vault_aldera_db_database | default(vault_solvo_db_database | default('aldera_tech')) }}?schema=public

AUTH_SECRET={{ vault_aldera_auth_secret | default(vault_solvo_auth_secret) }}
NEXTAUTH_URL={{ vault_aldera_nextauth_url | default(vault_solvo_nextauth_url | default('https://aldera.tech')) }}
NEXT_PUBLIC_APP_URL={{ vault_aldera_app_url | default(vault_solvo_app_url | default('https://aldera.tech')) }}
AUTH_TRUST_HOST=true

SMTP_HOST={{ vault_aldera_smtp_host | default(vault_solvo_smtp_host | default('')) }}
SMTP_PORT={{ vault_aldera_smtp_port | default(vault_solvo_smtp_port | default('587')) }}
SMTP_USER={{ vault_aldera_smtp_user | default(vault_solvo_smtp_user | default('')) }}
SMTP_PASSWORD={{ vault_aldera_smtp_password | default(vault_solvo_smtp_password | default('')) }}
SMTP_FROM={{ vault_aldera_smtp_from | default(vault_solvo_smtp_from | default('Aldera Tech <no-reply@aldera.tech>')) }}

CRON_SECRET={{ vault_aldera_cron_secret | default(vault_solvo_cron_secret) }}

SEED_ADMIN_EMAIL={{ vault_aldera_seed_admin_email | default(vault_solvo_seed_admin_email | default('admin@aldera.tech')) }}
SEED_ADMIN_PASSWORD={{ vault_aldera_seed_admin_password | default(vault_solvo_seed_admin_password) }}

WHATSAPP_API_URL={{ vault_aldera_whatsapp_api_url | default(vault_solvo_whatsapp_api_url | default('https://api.fonnte.com/send')) }}
WHATSAPP_API_KEY={{ vault_aldera_whatsapp_api_key | default(vault_solvo_whatsapp_api_key) }}

# Sharp / Image Processing
SHARP_IGNORE_GLOBAL_LIBVIPS=1

# Payment Gateway (Midtrans & Xendit)
MIDTRANS_SERVER_KEY={{ vault_aldera_midtrans_server_key | default(vault_solvo_midtrans_server_key | default('')) }}
MIDTRANS_CLIENT_KEY={{ vault_aldera_midtrans_client_key | default(vault_solvo_midtrans_client_key | default('')) }}
MIDTRANS_IS_PRODUCTION={{ vault_aldera_midtrans_is_production | default('false') }}

XENDIT_SECRET_KEY={{ vault_aldera_xendit_secret_key | default('') }}
XENDIT_CALLBACK_TOKEN={{ vault_aldera_xendit_callback_token | default('') }}

# Cloudflare Turnstile (Anti-Spam & Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY={{ vault_aldera_turnstile_site_key | default('') }}
TURNSTILE_SECRET_KEY={{ vault_aldera_turnstile_secret_key | default('') }}

