# Server
PORT={{ vault_sistertika_uty_api_port | default('8080') }}
GIN_MODE=release

# Database
DB_HOST={{ vault_sistertika_uty_api_db_host | default('postgres-db') }}
DB_PORT={{ vault_sistertika_uty_api_db_port | default('5432') }}
DB_USER={{ vault_sistertika_uty_api_db_username }}
DB_PASSWORD={{ vault_sistertika_uty_api_db_password }}
DB_NAME={{ vault_sistertika_uty_api_db_database }}
DB_SSLMODE={{ vault_sistertika_uty_api_db_sslmode | default(sistertika_uty_api_db_sslmode | default('disable')) }}

# JWT
JWT_SECRET={{ vault_sistertika_uty_api_jwt_secret }}
JWT_EXPIRY={{ vault_sistertika_uty_api_jwt_expiry | default('24h') }}
JWT_REFRESH_EXPIRY={{ vault_sistertika_uty_api_jwt_refresh_expiry | default('168h') }}

# Encryption
ENCRYPTION_KEY={{ vault_sistertika_uty_api_encryption_key }}

# File Upload
UPLOAD_DIR={{ vault_sistertika_uty_api_upload_dir | default('./uploads') }}
MAX_FILE_SIZE={{ vault_sistertika_uty_api_max_file_size | default('26214400') }}

# Backup Storage
BACKUP_DIR={{ vault_sistertika_uty_api_backup_dir | default(sistertika_uty_api_backup_dir | default('./storage/app/backups')) }}

# CORS
ALLOWED_ORIGINS={{ vault_sistertika_uty_api_allowed_origins | default('https://sistertika.com,https://api.sistertika.com,https://sistertika.alfian-gading.my.id,https://sistertika-api.alfian-gading.my.id') }}

# Timezone
TZ={{ vault_sistertika_uty_api_tz | default('Asia/Jakarta') }}
