# MySQL Docker Compose Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  mysql-db:
    image: {{ mysql_effective_image | default(mysql_auto_image | default('mariadb:10.11')) }}
    container_name: mysql-db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    volumes:
      - mysql_data:/var/lib/mysql
{% if mysql_custom_config | default(false) %}
      - ./my.cnf:/etc/mysql/conf.d/custom.cnf:ro
{% endif %}
    healthcheck:
      test: ["CMD", "{{ mysql_admin_binary | default('mariadb-admin') }}", "ping", "-h", "localhost", "-u", "root", "-p${MYSQL_ROOT_PASSWORD}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s
    networks:
      - {{ mysql_network }}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ mysql_memory_limit | default('1G') }}
        reservations:
          memory: {{ mysql_memory_reservation | default('512M') }}
    labels:
      - "autoheal=true"

{% if mysql_enable_phpmyadmin | default(true) %}
  phpmyadmin:
    image: phpmyadmin/phpmyadmin:{{ phpmyadmin_version | default('5.2.2') }}
    container_name: phpmyadmin
    restart: unless-stopped
    environment:
      PMA_HOST: mysql-db
      PMA_PORT: 3306
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      PMA_ARBITRARY: 0
      UPLOAD_LIMIT: {{ phpmyadmin_upload_limit | default('50M') }}
      MEMORY_LIMIT: {{ phpmyadmin_memory_limit | default('128M') }}
      MAX_EXECUTION_TIME: 300
    depends_on:
      mysql-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - {{ mysql_network }}
    ports:
      - "127.0.0.1:{{ phpmyadmin_port | default('8081') }}:80"
    security_opt:
      - no-new-privileges:true
    labels:
      - "autoheal=true"
{% endif %}

volumes:
  mysql_data:
    driver: local

networks:
  {{ mysql_network }}:
    name: {{ mysql_network }}
