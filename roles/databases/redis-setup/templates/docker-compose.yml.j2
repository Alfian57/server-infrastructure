# Redis Docker Compose Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  redis-server:
    container_name: redis-server
    image: {{ redis_effective_image | default(redis_auto_image | default('redis:8')) }}
    restart: unless-stopped
    networks:
      - {{ redis_network }}
    volumes:
      - redis_data:/data
{% if redis_custom_config | default(false) %}
      - ./redis.conf:/usr/local/etc/redis/redis.conf:ro
    command: redis-server /usr/local/etc/redis/redis.conf
{% else %}
    command: redis-server --save 60 1 --loglevel warning --requirepass ${REDIS_PASSWORD}
{% endif %}
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ redis_memory_limit | default('512M') }}
        reservations:
          memory: {{ redis_memory_reservation | default('256M') }}
    labels:
      - "autoheal=true"

{% if redis_enable_commander | default(true) %}
  redis-commander:
    container_name: redis-commander
    image: rediscommander/redis-commander:{{ redis_commander_version | default('latest') }}
    restart: unless-stopped
    environment:
      REDIS_HOSTS: local:redis-server:6379:0:${REDIS_PASSWORD}
      HTTP_USER: ${REDIS_COMMANDER_USER:-admin}
      HTTP_PASSWORD: ${REDIS_COMMANDER_PASSWORD:-adminpassword}
    networks:
      - {{ redis_network }}
    ports:
      - "127.0.0.1:{{ redis_commander_port | default('8083') }}:8081"
    depends_on:
      redis-server:
        condition: service_healthy
    security_opt:
      - no-new-privileges:true
    labels:
      - "autoheal=true"
{% endif %}

volumes:
  redis_data:
    driver: local

networks:
  {{ redis_network }}:
    name: {{ redis_network }}
    driver: bridge
