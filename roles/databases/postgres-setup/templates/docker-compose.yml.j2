# PostgreSQL Docker Compose Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  postgres-db:
    container_name: postgres-db
    image: {{ postgres_effective_image | default(postgres_auto_image | default('postgres:18-bookworm')) }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-postgres}
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
{% if postgres_custom_config | default(false) %}
      - ./postgresql.conf:/etc/postgresql/postgresql.conf:ro
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{ postgres_network }}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: {{ postgres_memory_limit | default('1G') }}
        reservations:
          memory: {{ postgres_memory_reservation | default('512M') }}
    labels:
      - "autoheal=true"

{% if postgres_enable_pgadmin | default(true) %}
  pgadmin:
    container_name: pgadmin
    image: dpage/pgadmin4:{{ pgadmin_version | default('9.14.0') }}
    restart: unless-stopped
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_DEFAULT_EMAIL:-admin@example.com}
      PGADMIN_DEFAULT_PASSWORD: ${POSTGRES_PASSWORD}
      PGADMIN_CONFIG_SERVER_MODE: "False"
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: "True"
    depends_on:
      postgres-db:
        condition: service_healthy
    networks:
      - {{ postgres_network }}
    ports:
      - "127.0.0.1:{{ pgadmin_port | default('8082') }}:80"
    healthcheck:
      test: ["CMD", "wget", "-O", "-", "http://localhost:80/misc/ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    security_opt:
      - no-new-privileges:true
    labels:
      - "autoheal=true"
{% endif %}

volumes:
  postgres_data:
    driver: local

networks:
  {{ postgres_network }}:
    name: {{ postgres_network }}
