#!/bin/bash
# Resource Usage Report
# Generates comprehensive resource usage report

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}  Resource Usage Report${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo ""
echo "Generated: $TIMESTAMP"
echo ""

# Disk Usage
echo -e "${YELLOW}▶ Disk Usage${NC}"
echo "─────────────────────────────────────────────────────"
df -h | grep -E "^/dev|Filesystem"
echo ""

# Memory Usage
echo -e "${YELLOW}▶ Memory Usage${NC}"
echo "─────────────────────────────────────────────────────"
free -h
echo ""

# CPU Usage
echo -e "${YELLOW}▶ CPU Information${NC}"
echo "─────────────────────────────────────────────────────"
echo "CPU cores: $(nproc)"
echo "Load average: $(uptime | awk -F'load average:' '{print $2}')"
echo ""

# Top processes by CPU
echo -e "${YELLOW}▶ Top 5 Processes by CPU${NC}"
echo "─────────────────────────────────────────────────────"
ps aux --sort=-%cpu | head -6
echo ""

# Top processes by Memory
echo -e "${YELLOW}▶ Top 5 Processes by Memory${NC}"
echo "─────────────────────────────────────────────────────"
ps aux --sort=-%mem | head -6
echo ""

# Docker Resources
if command -v docker &> /dev/null; then
    echo -e "${YELLOW}▶ Docker Resource Usage${NC}"
    echo "─────────────────────────────────────────────────────"
    docker system df
    echo ""
    
    echo -e "${YELLOW}▶ Container Stats (Current)${NC}"
    echo "─────────────────────────────────────────────────────"
    docker stats --no-stream --format "table {% raw %}{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}{% endraw %}"
    echo ""
fi

# Disk Usage by Directory
echo -e "${YELLOW}▶ Top 10 Largest Directories${NC}"
echo "─────────────────────────────────────────────────────"
du -h / 2>/dev/null | sort -rh | head -10
echo ""

# Log Sizes
echo -e "${YELLOW}▶ Log Directory Sizes${NC}"
echo "─────────────────────────────────────────────────────"
du -sh /var/log/* 2>/dev/null | sort -rh | head -10
echo ""

# Docker Images
if command -v docker &> /dev/null; then
    echo -e "${YELLOW}▶ Docker Images${NC}"
    echo "─────────────────────────────────────────────────────"
    docker images --format "table {% raw %}{{.Repository}}\t{{.Tag}}\t{{.Size}}\t{{.CreatedAt}}{% endraw %}" | head -11
    echo ""
fi

# Cleanup Recommendations
echo -e "${YELLOW}▶ Optimization Recommendations${NC}"
echo "─────────────────────────────────────────────────────"

DISK_USAGE=$(df -h / | tail -1 | awk '{print $5}' | sed 's/%//')
if [ "$DISK_USAGE" -ge {{ cost_disk_warning_threshold }} ]; then
    echo "⚠ Disk usage is high (${DISK_USAGE}%)"
    echo "  → Run: docker-cleanup"
    echo "  → Run: apt-get autoremove && apt-get autoclean"
fi

# Check for old Docker images
OLD_IMAGES=$(docker images --format "{% raw %}{{.CreatedAt}}{% endraw %}" | grep -c "months ago" 2>/dev/null || echo 0)
if [ "$OLD_IMAGES" -gt 0 ]; then
    echo "⚠ Found $OLD_IMAGES old Docker images"
    echo "  → Run: docker image prune -a -f"
fi

# Check log size
LOG_SIZE=$(du -sm /var/log 2>/dev/null | awk '{print $1}')
if [ "$LOG_SIZE" -gt 500 ]; then
    echo "⚠ Log directory is large (${LOG_SIZE}MB)"
    echo "  → Run: journalctl --vacuum-time=7days"
    echo "  → Check: du -sh /var/log/*"
fi

echo ""
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo ""
