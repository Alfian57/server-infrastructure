#!/bin/bash

# =============================================================================
# Update GitHub Repository Secrets for CI/CD
# =============================================================================
# This script updates GitHub secrets for all application repositories
# Secrets: VPS_HOST, VPS_USER, VPS_KEY, VPS_SSH_PORT, DOCKER_TOKEN
#
# Usage:
#   ./scripts/update-github-secrets.sh
#   
# Or via Makefile:
#   make update-github-secrets
# =============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;36m'
NC='\033[0m' # No Color

# =============================================================================
# Configuration
# =============================================================================

# Parse arguments
NON_INTERACTIVE=false
CUSTOM_REPOS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -y|--yes)
      NON_INTERACTIVE=true
      shift
      ;;
    *)
      CUSTOM_REPOS+=("$1")
      shift
      ;;
  esac
done

# GitHub Owner
GITHUB_OWNER="Alfian57"

# Default repositories (all applications)
DEFAULT_REPOS=(
  # Laravel Applications
  "materi-ku"
  "panca-trivia"
  "ruang-istirahat"
  "tech-talk"
  "posyandu"
  "solvo"
  "Presensi-Skansaba-Web"
  # Go Applications
  "campus-project-hub-api"
  "ruang-tenang-api"
  # Next.js Applications
  "campus-project-hub-web"
  "personal-portofolio"
  "ruang-tenang-web"
  # Node.js/Express Applications
  "file-pod-api"
)

# Paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANSIBLE_DIR="/home/deployer/ansible-workspace"
INVENTORY_FILE="${ANSIBLE_DIR}/hosts.ini"
ANSIBLE_CFG="${ANSIBLE_DIR}/ansible.cfg"
VAULT_FILE="${ANSIBLE_DIR}/vault.yml"
VAULT_PASS_FILE="${ANSIBLE_DIR}/.vault_pass"
PRIVATE_KEY_PATH="/home/deployer/.ssh/server_ed25519"

# =============================================================================
# Functions
# =============================================================================

print_header() {
  echo ""
  echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║${NC}  ${GREEN}Update GitHub Repository Secrets${NC}                          ${BLUE}║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"
  echo ""
}

print_step() {
  echo -e "${BLUE}▶${NC} $1"
}

print_success() {
  echo -e "${GREEN}✓${NC} $1"
}

print_error() {
  echo -e "${RED}✗${NC} $1"
}

print_warning() {
  echo -e "${YELLOW}⚠${NC} $1"
}

check_requirements() {
  print_step "Checking requirements..."
  
  # Check if gh CLI is installed
  if ! command -v gh &> /dev/null; then
    print_error "GitHub CLI (gh) is not installed"
    echo ""
    echo "Install GitHub CLI first:"
    echo "  make setup-github-cli"
    echo "  OR manually: https://cli.github.com/"
    exit 1
  fi
  print_success "GitHub CLI found: $(gh --version | head -1)"
  
  # Check if authenticated
  if ! gh auth status &> /dev/null; then
    print_error "GitHub CLI is not authenticated"
    echo ""
    echo "Authenticate with GitHub:"
    echo "  gh auth login"
    echo "  OR: echo \"\$GITHUB_TOKEN\" | gh auth login --with-token"
    exit 1
  fi
  print_success "GitHub CLI authenticated"
  
  # Check if inventory file exists
  if [ ! -f "$INVENTORY_FILE" ]; then
    print_error "Inventory file not found: $INVENTORY_FILE"
    exit 1
  fi
  
  # Check if private key exists
  if [ ! -f "$PRIVATE_KEY_PATH" ]; then
    print_error "Private key not found: $PRIVATE_KEY_PATH"
    echo ""
    echo "Expected private key location: $PRIVATE_KEY_PATH"
    exit 1
  fi
  print_success "Private key found: $PRIVATE_KEY_PATH"
  
  # Check if vault password file exists
  if [ ! -f "$VAULT_PASS_FILE" ]; then
    print_error "Vault password file not found: $VAULT_PASS_FILE"
    exit 1
  fi
  
  echo ""
}

get_vps_host() {
  # Extract IP from inventory file
  local host=$(grep -v "^#" "$INVENTORY_FILE" | grep -v "^\[" | grep -v "^$" | head -1 | awk '{print $1}')
  if [ -z "$host" ]; then
    print_error "Could not extract VPS_HOST from inventory"
    exit 1
  fi
  echo "$host"
}

get_ssh_port() {
  # Extract SSH port from ansible.cfg
  local port=$(grep "^ansible_port" "$ANSIBLE_CFG" | awk -F'=' '{print $2}' | tr -d ' ')
  if [ -z "$port" ]; then
    port="22"  # default SSH port
  fi
  echo "$port"
}

get_github_token() {
  # Decrypt and extract GitHub token from vault
  local token=$(ansible-vault view "$VAULT_FILE" --vault-password-file="$VAULT_PASS_FILE" 2>/dev/null | grep "vault_github_token:" | awk '{print $2}' | tr -d '"')
  if [ -z "$token" ]; then
    print_error "Could not extract GitHub token from vault"
    exit 1
  fi
  echo "$token"
}

update_secret() {
  local repo=$1
  local secret_name=$2
  local secret_value=$3
  local full_repo="${GITHUB_OWNER}/${repo}"
  
  # Check if repository exists
  if ! gh repo view "$full_repo" &> /dev/null; then
    print_warning "Repository not found: $full_repo (skipping)"
    return 1
  fi
  
  # Update secret
  echo "$secret_value" | gh secret set "$secret_name" --repo "$full_repo" 2>&1
  if [ $? -eq 0 ]; then
    print_success "Updated $secret_name in $full_repo"
    return 0
  else
    print_error "Failed to update $secret_name in $full_repo"
    return 1
  fi
}

update_repository_secrets() {
  local repo=$1
  local full_repo="${GITHUB_OWNER}/${repo}"
  
  echo ""
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${YELLOW}Repository: ${full_repo}${NC}"
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  
  # Get values
  local vps_host=$(get_vps_host)
  local vps_user="deployer"
  local vps_ssh_port=$(get_ssh_port)
  local vps_key=$(cat "$PRIVATE_KEY_PATH")
  local docker_token=$(get_github_token)
  
  # Update each secret
  update_secret "$repo" "VPS_HOST" "$vps_host"
  update_secret "$repo" "VPS_USER" "$vps_user"
  update_secret "$repo" "VPS_SSH_PORT" "$vps_ssh_port"
  update_secret "$repo" "VPS_KEY" "$vps_key"
  update_secret "$repo" "DOCKER_TOKEN" "$docker_token"
}

# =============================================================================
# Main Script
# =============================================================================

main() {
  print_header
  check_requirements
  
  # Get repositories to update
  local repos=("${DEFAULT_REPOS[@]}")
  
  # Allow custom repositories via arguments
  if [ ${#CUSTOM_REPOS[@]} -gt 0 ]; then
    repos=("${CUSTOM_REPOS[@]}")
  fi
  
  echo -e "${BLUE}Repositories to update:${NC}"
  for repo in "${repos[@]}"; do
    echo "  - ${GITHUB_OWNER}/${repo}"
  done
  echo ""
  
  # Confirm (skip if non-interactive)
  if [ "$NON_INTERACTIVE" = false ]; then
    read -p "Continue? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      print_warning "Cancelled by user"
      exit 0
    fi
  else
    print_step "Running in non-interactive mode (-y flag)"
  fi
  
  # Update secrets for each repository
  local success_count=0
  local fail_count=0
  
  for repo in "${repos[@]}"; do
    if update_repository_secrets "$repo"; then
      ((success_count++))
    else
      ((fail_count++))
    fi
  done
  
  # Summary
  echo ""
  echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║${NC}  ${GREEN}Summary${NC}                                                      ${BLUE}║${NC}"
  echo -e "${BLUE}╠═══════════════════════════════════════════════════════════════╣${NC}"
  echo -e "${BLUE}║${NC}  Repositories processed: {% raw %}${#repos[@]}{% endraw %}                                ${BLUE}║${NC}"
  echo -e "${BLUE}║${NC}  ${GREEN}Successful: ${success_count}${NC}                                         ${BLUE}║${NC}"
  if [ $fail_count -gt 0 ]; then
    echo -e "${BLUE}║${NC}  ${RED}Failed: ${fail_count}${NC}                                              ${BLUE}║${NC}"
  fi
  echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  
  if [ $fail_count -gt 0 ]; then
    exit 1
  fi
}

# Run main function with all arguments
main "$@"
