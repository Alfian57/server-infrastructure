# Autoheal Docker Compose Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  autoheal:
    image: {{ autoheal_image | default('willfarrell/autoheal:latest') }}
    container_name: autoheal
    restart: unless-stopped
    environment:
      - AUTOHEAL_CONTAINER_LABEL={{ autoheal_label | default('all') }}
      - AUTOHEAL_INTERVAL={{ autoheal_interval | default('5') }}
      - AUTOHEAL_START_PERIOD={{ autoheal_start_period | default('0') }}
      - AUTOHEAL_DEFAULT_STOP_TIMEOUT={{ autoheal_stop_timeout | default('10') }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    healthcheck:
      test: ["CMD", "pgrep", "autoheal"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    read_only: true
    networks:
      - autoheal_network

networks:
  autoheal_network:
    driver: bridge
