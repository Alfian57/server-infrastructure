# ------------------------------------------------------------
# {{ target_domain }}
# Generated by Ansible for Cloudflare Flexible SSL
# Uses self-signed certificate (Cloudflare handles client SSL)
# ------------------------------------------------------------

map $scheme $hsts_header {
    https   "max-age=63072000; preload";
}

server {
  set $forward_scheme http;
  set $server         "{{ forward_host }}";
  set $port           {{ forward_port }};

  listen 80;
  listen 443 ssl;

  server_name {{ target_domain }};
  http2 on;

  # Self-signed SSL (for Cloudflare Flexible SSL mode)
  ssl_certificate {{ ssl_cert_path }};
  ssl_certificate_key {{ ssl_key_path }};

{% if caching_enabled %}
  # Asset Caching
  include conf.d/include/assets.conf;
{% endif %}

  # Block Exploits
  include conf.d/include/block-exploits.conf;

  access_log /data/logs/proxy-host-{{ host_id }}_access.log proxy;
  error_log /data/logs/proxy-host-{{ host_id }}_error.log warn;

  location / {
    # Proxy!
    include conf.d/include/proxy.conf;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Ssl on;
  }

  # Custom
  include /data/nginx/custom/server_proxy[.]conf;
}
